# Salin file ini menjadi /home/smkn55jakarta/zivar-absensi/.env
# Sesuaikan DB_USER, DB_PASS, dan DB_NAME dengan MariaDB di server.

APP_PORT=55120
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=user_db
DB_PASS=password_db
DB_NAME=nama_database

# auto = otomatis mendeteksi database Revamp (unbk_*) atau Legacy (tb_*)
DB_SCHEMA=auto

# Ganti dengan string acak minimal 32 karakter (misal: openssl rand -hex 32)
SESSION_SECRET=ganti-dengan-secret-acak-minimal-32-karakter

# Set 0 jika diakses lewat http://IP:55120, ubah ke 1 jika sudah pakai HTTPS
SECURE_COOKIE=0

TZ=Asia/Jakarta
