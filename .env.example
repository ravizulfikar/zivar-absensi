# Konfigurasi Aplikasi Absensi QR & RFID
# Salin file ini menjadi .env lalu sesuaikan kredensial database Anda.

APP_PORT=8090
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASS=
DB_NAME=db_ujian55

# Mode skema database: auto (deteksi otomatis revamp/legacy), revamp (unbk_*), atau legacy (tb_*)
DB_SCHEMA=auto

# Secret untuk penandatanganan session cookie admin/guru (ganti di produksi minimal 32 karakter)
SESSION_SECRET=ganti-dengan-secret-acak-minimal-32-karakter

# Set 1 jika diakses melalui HTTPS (Reverse Proxy + SSL), set 0 jika masih HTTP lokal
SECURE_COOKIE=0

# Zona waktu sekolah
TZ=Asia/Jakarta
